BEARER_TOKEN="your_bearer_token"
PATH_TO_CREDENTIALS="/full/path/to/your/service-account.json"

# Google SSO for the /imports UI. Both come from the OAuth 2.0 "Web
# application" client in the GCP project; its authorised redirect URIs must
# include http://localhost:4000/auth/google/callback for local work.
GOOGLE_OAUTH_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your_oauth_client_secret"

# Local-only escape hatch: skip Google entirely and sign in as a stub user.
# Also gated on the compile-time Mix environment, so it does nothing when the
# app is built with MIX_ENV=prod. Use this instead of creating an OAuth client
# if you only need the imports UI locally.
IMPORTS_AUTH_BYPASS="true"
IMPORTS_AUTH_BYPASS_EMAIL="you@avantifellows.org"

# Optional. Workspace domain allowed into /imports; defaults to
# avantifellows.org when unset.
IMPORTS_ALLOWED_DOMAIN="avantifellows.org"

# Optional. Shared password on the destructive import types (dropout,
# re-enrollment, auth group, product, program, batch) and on LiveDashboard in
# production. These sit on top of SSO, so both are needed to run those imports.
DASHBOARD_USER="admin"
DASHBOARD_PASS="password"
